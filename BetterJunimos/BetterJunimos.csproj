<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SMAPI 4.x 基于 .NET 6 运行时 -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BetterJunimos</AssemblyName>
    <RootNamespace>BetterJunimos</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <!-- 与 N 网 3.1.2 保持同版本号（manifest 也一致），修复版在 README 里说明 -->
    <Version>3.1.2</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- 编译完成后把运行所需文件复制到游戏 Mods\BetterJunimos（照 BidirectionalHopper 已验证的部署模式） -->
  <Target Name="DeployModFiles" AfterTargets="Build">
    <ItemGroup>
      <ModDeployFiles Include="$(TargetPath)" />
      <ModDeployFiles Include="$(ProjectDir)manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ModDeployFiles)" DestinationFolder="$(ProjectDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <!-- Harmony 补丁库（与 SMAPI 4.5 内置的 0Harmony.dll 2.2.2 对齐；运行时由 SMAPI 提供，不随 Mod 分发） -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Update="0Harmony">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
